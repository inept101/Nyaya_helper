# LLM — any OpenAI-compatible endpoint
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Pinecone (free tier)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=nyayahelper

# Supabase PostgreSQL — use Transaction Mode pooler (port 6543)
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
UPLOAD_DIR=./uploads

# Indian Kanoon (live legal database)
# Sign up at https://api.indiankanoon.org — Rs 500 dev credit + Rs 10K/month for non-commercial use
INDIAN_KANOON_API_TOKEN=
# Set false to call the real API; true serves mock fixtures (no API quota burned)
LEGAL_SEARCH_MOCK_MODE=true
LEGAL_SEARCH_CACHE_TTL_HOURS=168
